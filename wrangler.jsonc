{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "discussion-workers",
  "main": "worker/src/index.ts",
  "compatibility_date": "2025-04-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bbs",
      // 本地预览可先用占位 UUID，远端部署前替换成 wrangler d1 create 返回的真实 database_id
      "database_id": "38fcd837-dfb7-4fe6-b82b-31273aaf8841",
      "migrations_dir": "worker/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES_BUCKET",
      // 部署前替换成你自己的 R2 bucket 名称
      "bucket_name": "bbs",
      "preview_bucket_name": "bbs"
    }
  ]
}
